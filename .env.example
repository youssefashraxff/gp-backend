# Copy to .env and fill in. Never commit .env.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Tool and model keys (plan P2–P4), used by app/shared/tools/ and experiments/
# Google Maps Platform: one key with Places API (New), Routes API and Maps Elevation API enabled
GOOGLE_MAPS_API_KEY=
SERPER_API_KEY=
# Optional: where the local OpenStreetMap cache lives (default data/osm/osm_cache.json.gz)
# OSM_CACHE_PATH=
# Experiments only: alternatives compared against the chosen tools
TAVILY_API_KEY=
FOURSQUARE_API_KEY=
OPENROUTESERVICE_API_KEY=
# LLM provider keys: add the ones the agent owners choose, e.g.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
