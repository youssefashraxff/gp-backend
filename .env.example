# Copy to .env and fill in. Never commit .env.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Tool keys (plan P2–P3), used by app/shared/tools/ and experiments/
# Google Maps Platform: one key restricted to Places API (New), Routes API and Maps Elevation API
GOOGLE_MAPS_API_KEY=
# Web search (chosen tool, see experiments/tools/web_search/reports/)
SERPER_API_KEY=

# Experiment-only keys: alternatives compared against the chosen tools
TAVILY_API_KEY=
FOURSQUARE_API_KEY=
OPENROUTESERVICE_API_KEY=
# Overpass (OSM), OpenTopoData (elevation) and OSRM (routing) need no key

# LLM provider keys: add the ones the agent owners choose, e.g.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
